{
  "permissions": {
    "allow": [
      "Bash(git stash)",
      "Bash(git stash push *)",
      "Bash(git stash save *)",
      "Bash(git stash list)",
      "Bash(git stash list *)"
    ],
    "ask": [
      "Bash(git stash pop)",
      "Bash(git stash pop *)",
      "Bash(git stash apply)",
      "Bash(git stash apply *)",
      "Bash(git reset --hard)",
      "Bash(git reset --hard *)",
      "Bash(git restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout . *)",
      "Bash(git revert *)"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(unlink *)",
      "Bash(find * -delete*)",
      "Bash(git rm *)",
      "Bash(git clean *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push * +*)",
      "Bash(git push --delete *)",
      "Bash(git push * --delete *)",
      "Bash(git push * :*)",
      "Bash(git stash drop)",
      "Bash(git stash drop *)",
      "Bash(git stash clear)",
      "Bash(git clean)",
      "Bash(git branch -D *)",
      "Bash(git reflog expire *)",
      "Bash(git reflog delete *)",
      "Bash(git update-ref -d *)",
      "Bash(git filter-branch *)",
      "Bash(git gc --prune*)",
      "Bash(sudo *)",
      "Bash(dd *)",
      "Bash(mkfs *)",
      "Bash(shred *)",
      "Bash(diskutil erase*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/user-prompt-submit.sh\"",
            "timeout": 10,
            "statusMessage": "재시도 횟수 초기화 중"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash.sh\"",
            "timeout": 10,
            "statusMessage": "삭제 명령 검사 중"
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-bash-install.sh\"",
            "timeout": 10,
            "statusMessage": "설치 명령 기록 중"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop.sh\"",
            "timeout": 30,
            "statusMessage": "페이지 규칙 검사 중"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false
  }
}
